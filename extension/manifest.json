{
  "manifest_version": 3,
  "name": "lc-coach",
  "version": "0.1.0",
  "description": "Personal LeetCode coach: Socratic hints, mastery tracking, and target-company recommendations inline on leetcode.com.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open lc-coach side panel"
  }
}
